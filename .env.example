# --- OpenSky Network (anonymous — no API key required) ---
# Leave empty for worldwide; otherwise lat_min,lat_max,lng_min,lng_max
OPENSKY_BBOX=
OPENSKY_POLL_SECONDS=1

# Basic auth credentials (optional, 4000 req/h instead of 10 req/min)
# Sign up at https://opensky-network.org
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# --- Database ---
DATABASE_URL=sqlite:///data/flight_tracker.db

# --- Logging ---
LOG_LEVEL=INFO
