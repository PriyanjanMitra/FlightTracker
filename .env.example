# --- OpenSky Network (anonymous — no API key required) ---
# Leave empty for worldwide; otherwise lat_min,lat_max,lng_min,lng_max
OPENSKY_BBOX=
OPENSKY_POLL_SECONDS=120

# OpenSky client credentials (optional but recommended).
# For 4000 req/h instead of 10 req/min, place a credentials.json in the project
# root with {"clientId": "...", "clientSecret": "..."} from the OpenSky API
# client console. Username/password below also work as an alternative.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# --- Aircraft registry (icao24 -> typecode) ---
# Built once from the OpenSky aircraft database:
#   python scripts/build_aircraft_index.py <aircraft.csv> data/aircraft_registry.db
# Provides offline aircraft type/registration lookups used as the primary type source.
AIRCRAFT_REGISTRY_DB=data/aircraft_registry.db

# --- Database ---
DATABASE_URL=sqlite:///data/flight_tracker.db

# --- Logging ---
LOG_LEVEL=INFO
